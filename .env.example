# Safe placeholders for Compose validation only.
# Run tools/setup-local.php as documented to create .env.local with random secrets.
HTTP_PORT=18081
DEV_HTTP_PORT=18082
LOCAL_UID=1000
LOCAL_GID=1000
APP_SECRET=change-me-random-64-hex-characters
POSTGRES_PASSWORD=change-me-random-48-hex-characters
# Empty means no trusted proxy. Set only explicit addresses/CIDRs you administer.
TRUSTED_PROXIES=
