{
    "name": "ecotrip/ecotrip",
    "description": "Démonstrateur de comparaison de voyages — socle modulaire",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dom-crawler": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/lock": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^3.4",
        "symfony/stopwatch": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/twig-bridge": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5", "symfony/browser-kit": "7.4.*", "symfony/css-selector": "7.4.*",
        "cebe/php-openapi": "^1.8"
    },
    "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
    "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
    "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true, "platform": {"php": "8.4.19"}},
    "scripts": {
        "test": "php bin/phpunit",
        "check": [
            "@test",
            "php bin/console lint:container",
            "php bin/console lint:twig templates",
            "php bin/console lint:yaml config docs/openapi.yaml",
            "php bin/console asset-map:compile",
            "php tools/validate-contract.php"
        ]
    }
}
