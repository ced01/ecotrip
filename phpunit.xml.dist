<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache" failOnWarning="true" failOnRisky="true">
  <php><env name="APP_ENV" value="test" force="true"/><env name="APP_DEBUG" value="0" force="true"/><server name="KERNEL_CLASS" value="App\Kernel"/></php>
  <testsuites><testsuite name="integration"><directory>tests/Integration</directory></testsuite><testsuite name="api"><directory>tests/Api</directory></testsuite><testsuite name="frontend"><directory>tests/Frontend</directory></testsuite></testsuites>
</phpunit>
